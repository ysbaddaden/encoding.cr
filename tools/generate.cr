# Regenerate embedded mappings from the cached, pinned WHATWG snapshot. No network.
require "./source_cache"
root = SourceCache::ROOT
SourceCache.verify("whatwg")

sources = SourceCache.directory("whatwg")
indexes = JSON.parse(File.read("#{sources}/indexes.json"))
encodings = JSON.parse(File.read("#{sources}/encodings.json"))

source = String.build do |io|
  io << "# Generated by tools/generate.cr. Do not edit.\n# WHATWG copyright and BSD terms: see NOTICE and licenses/WHATWG.txt.\nmodule Encoding\n  private module Data\n"
  io << "    SIZE = " << indexes.as_h.size << "\n"

  names = indexes.as_h.keys.reject { |name| name == "gb18030-ranges" }.sort

  single_byte = names.select { |name| indexes[name].as_a.size == 128 }
  names.each do |name|
    values = indexes[name].as_a.map(&.as_i?)
    values.each do |cp|
      next unless cp

      raise "Invalid Unicode scalar in #{name}" unless (0..0x10ffff).includes?(cp) && !(0xd800..0xdfff).includes?(cp)
    end

    # BMP indexes fit in UInt16; supplementary mappings use Int32 directly.
    wide = values.any? { |cp| cp && cp >= 0xffff }
    type = wide ? "Int32" : "UInt16"
    undefined = wide ? -1 : 0xffff
    constant = name.upcase.tr("-", "_")
    io << "    #{constant} = Slice(#{type}).literal("
    io << values.map { |cp| cp || undefined }.join(", ")
    io << ")\n"
  end

  io << "    SINGLE_BYTE_INDEXES = {\n"
  single_byte.each do |name|
    io << "      #{name.inspect} => #{name.upcase.tr("-", "_")},\n"
  end
  io << "    }\n"

  io << "\n  GB18030_RANGES = [\n"
  indexes["gb18030-ranges"].as_a.each { |v| io << "    {#{v[0].as_i}, #{v[1].as_i}},\n" }

  io << "  ]\n  LABELS = {\n"
  labels = {} of String => String
  encodings.as_a.each do |group|
    group["encodings"].as_a.each do |encoding|
      encoding["labels"].as_a.each { |label| labels[label.as_s] = encoding["name"].as_s }
    end
  end
  # UTF-32 is supported as an extension to the WHATWG encoding set.
  labels["utf-32"] = "UTF-32LE"
  labels["utf-32le"] = "UTF-32LE"
  labels["utf-32be"] = "UTF-32BE"
  labels.keys.sort!.each { |label| io << "    #{label.inspect} => #{labels[label].inspect},\n" }

  io << "  }\n  end\nend\n"
end

# Keep generated output identical to the formatter used by CI.
{"data.cr" => source}.each do |name, generated|
  formatted = IO::Memory.new
  status = Process.run("crystal", ["tool", "format", "-"], input: IO::Memory.new(generated), output: formatted)
  abort "Could not format generated tables" unless status.success?
  path = "#{root}/src/encoding/#{name}"

  if ARGV.includes?("--check")
    abort "Generated tables are stale: #{name}" unless File.file?(path) && File.read(path) == formatted.to_s
  else
    File.write(path, formatted.to_s)
  end
end
